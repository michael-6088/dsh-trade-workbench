{
  "name": "dsh-trade-workbench",
  "version": "0.6.0",
  "description": "全流程外贸工作台：获客(三层搜索/背调/邮箱验证) → 转化(SOP流程/开发信/序列/客服审核) → 交付(询盘/报价PI/订单/单证/收汇) → 支撑(知识库/运维) → 分析(看板/效果统计)。19 个面板，54 个 AI 工具，本地 SQLite。",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "trade",
    "crm",
    "lead-generation",
    "外贸",
    "获客"
  ],
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test test/unit/calc.test.mjs test/unit/repo.test.mjs test/unit/kb.test.mjs test/integration/host-routes.test.mjs test/integration/client-bundle.test.mjs",
    "verify": "node scripts/build.mjs && node scripts/check.mjs && tsc --noEmit -p tsconfig.json && npm test"
  },
  "engines": {
    "node": ">=22.13"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0 <5",
    "react": ">=18.2.0 <19"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "npm@10",
  "dependencies": {
    "unpdf": "^2.2.1",
    "tesseract.js": "^7.0.0",
    "@tesseract.js-data/chi_sim": "^1.0.0"
  }
}
